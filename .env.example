# SURAKSHA — Supabase Auth (optional)
#
# Leave both blank for the built-in local demo auth (signs in on-device).
# To route sign-in through Supabase Auth, paste your project's PUBLIC values:
#
#   1. In the Supabase dashboard: Project Settings → API
#   2. Copy "Project URL" and the "anon" / "public" key (NEVER service_role).
#
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
#
# The anon key is designed to be public. It gates access via Row Level
# Security policies, not secrecy.
