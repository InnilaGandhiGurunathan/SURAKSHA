# SURAKSHA — optional environment variables.
#
# Copy to .env (git-ignored) and restart the dev server: Vite freezes env values
# into the bundle at build time, so hot reload will NOT pick up an edit.
#
#   cp .env.example .env
#   npm run maps:check     # tells you if the key is actually readable
#
# Only names starting with VITE_ reach browser code. Without this key SURAKSHA
# uses its built-in simulated map — nothing else breaks.

# Google Maps JavaScript API key (39 chars, starts with "AIza").
# Enable "Maps JavaScript API" in the same Cloud project.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Maps JavaScript API "Map ID" (map_ids=…). Only needed for vector
# maps or AdvancedMarkerElement; the app works without it.
VITE_GOOGLE_MAPS_MAP_ID=
