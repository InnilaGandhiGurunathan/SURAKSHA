node_modules
dist
dist-ssr
.DS_Store
*.local
*.log
.vite

tsconfig.tsbuildinfo
*.tsbuildinfo

# --- Guard against the tsc-emit traps (see README "Build hygiene") ----------
# `tsc -b --noEmit false` used to emit JS next to the sources. Vitest then
# resolves the stale .js instead of the .ts/.tsx, so code edits look like they
# did nothing. Never commit emitted JavaScript from src/.
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
# ...but vite-env.d.ts is hand-written (import.meta.env typings), keep it.
!src/vite-env.d.ts
# That same command emitted a root vite.config.js, which Vite resolves BEFORE
# vite.config.ts — silently shadowing the real config.
/vite.config.js
# NOTE: postcss.config.js and tailwind.config.js are legitimately JS (they have
# no .ts counterparts) and must be kept.

# Browser test output
/test-results/
/playwright-report/

# Local env — never commit real credentials (see .env.example)
.env
.env.local
.env.*.local
